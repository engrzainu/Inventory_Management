# Settings for running on your shop computer. Copy this file to inventory.env and edit it.
# Lines starting with # are comments. Do NOT put spaces around the = sign.

# Your MySQL login (the one you chose when installing MySQL)
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# The first Inventory Admin. Used only the first time the app starts with an empty database.
INVENTORY_ADMIN_USERNAME=admin
INVENTORY_ADMIN_PASSWORD=choose-a-strong-password

# Only needed for backups if mysqldump is not found automatically:
# MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
# MYSQL=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe
